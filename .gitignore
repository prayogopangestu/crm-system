# Dependency directories
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build outputs
/.next/
/out/
/build

# Debugging logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Local environment configuration files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and editors configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# TypeScript compiler build info
*.tsbuildinfo
next-env.d.ts

# Go backend environment and local secrets
/backend/.env
/backend/.env.*
!/backend/configs/.env.example
/backend/configs/config.local.yaml
/backend/configs/config.*.local.yaml

# Go backend build output
/backend/bin/
/backend/dist/
/backend/build/
/backend/*.exe
/backend/*.exe~
/backend/*.dll
/backend/*.so
/backend/*.dylib
/backend/*.test
/backend/*.prof

# Go backend caches and test coverage
/backend/.gocache/
/backend/.cache/
/backend/coverage/
/backend/coverage.out
/backend/coverage.html
/backend/*.coverprofile

# Workspace-local tool caches
**/.gocache/
**/.cache/
**/.testcache/
**/.verifycache/

# Go backend runtime files
/backend/tmp/
/backend/logs/
/backend/*.log
/backend/*.pid

# Local databases
/backend/*.db
/backend/*.db-shm
/backend/*.db-wal
/backend/*.sqlite
/backend/*.sqlite3
